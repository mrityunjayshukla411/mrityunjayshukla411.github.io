{% assign postlist = site.research_log | where_exp: "post", "post.categories contains include.category" | sort: "date" | reverse %}

<div class="post">
  <div class="header-bar">
    <h1>{{ include.title }}</h1>
    <h2>{{ include.subtitle }}</h2>
  </div>

  <div class="d-flex align-items-center gap-3 mb-4 mt-3">
    <input
      type="text"
      id="rl-search"
      class="form-control"
      placeholder="Search entries…"
      style="max-width: 280px;"
    >
    <div class="btn-group ms-auto" role="group" aria-label="View toggle">
      <button type="button" class="btn btn-sm btn-outline-secondary active" id="btn-card-view" title="Card view">
        <i class="fa-solid fa-grip"></i>
      </button>
      <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-list-view" title="List view">
        <i class="fa-solid fa-list"></i>
      </button>
    </div>
  </div>

  <p id="rl-no-results" style="display: none; color: var(--global-text-color-light);">No entries found.</p>

  <!-- Card view (default) -->
  <div id="rl-card-view" class="row row-cols-1 row-cols-md-2 g-3 mb-4">
    {% for post in postlist %}
      {% assign read_time = post.content | number_of_words | divided_by: 180 | plus: 1 %}
      <div class="col rl-entry"
           data-search="{{ post.title | downcase }} {{ post.description | downcase }} {{ post.tags | join: ' ' | downcase }}">
        <a href="{{ post.url | relative_url }}" style="text-decoration: none;">
          <div class="card hoverable h-100">
            <div class="card-body">
              <h3 class="card-title">{{ post.title }}</h3>
              <p class="card-text">{{ post.description }}</p>
              <p class="post-meta mb-1">
                {{ read_time }} min read &nbsp;&middot;&nbsp; {{ post.date | date: '%B %d, %Y' }}
              </p>
              {% assign joined_tags = post.tags | join: "" %}
              {% if joined_tags != "" %}
                <p class="post-tags mb-0">
                  {% for tag in post.tags %}
                    <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}{% unless forloop.last %}&nbsp;{% endunless %}
                  {% endfor %}
                </p>
              {% endif %}
            </div>
          </div>
        </a>
      </div>
    {% endfor %}
  </div>

  <!-- List view (hidden by default) -->
  <ul id="rl-list-view" class="post-list" style="display: none;">
    {% for post in postlist %}
      {% assign read_time = post.content | number_of_words | divided_by: 180 | plus: 1 %}
      <li class="rl-entry"
          data-search="{{ post.title | downcase }} {{ post.description | downcase }} {{ post.tags | join: ' ' | downcase }}">
        <h3>
          <a class="post-title" href="{{ post.url | relative_url }}">{{ post.title }}</a>
        </h3>
        <p>{{ post.description }}</p>
        <p class="post-meta">
          {{ read_time }} min read &nbsp;&middot;&nbsp; {{ post.date | date: '%B %d, %Y' }}
        </p>
        {% assign joined_tags = post.tags | join: "" %}
        {% if joined_tags != "" %}
          <p class="post-tags">
            {% for tag in post.tags %}
              <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}{% unless forloop.last %}&nbsp;{% endunless %}
            {% endfor %}
          </p>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</div>

<script>
(function () {
  var searchInput = document.getElementById('rl-search');
  var btnCard    = document.getElementById('btn-card-view');
  var btnList    = document.getElementById('btn-list-view');
  var cardView   = document.getElementById('rl-card-view');
  var listView   = document.getElementById('rl-list-view');
  var noResults  = document.getElementById('rl-no-results');
  var currentView = 'card';

  btnCard.addEventListener('click', function () {
    if (currentView === 'card') return;
    currentView = 'card';
    cardView.style.display = '';
    listView.style.display = 'none';
    btnCard.classList.add('active');
    btnList.classList.remove('active');
    filterEntries(searchInput.value);
  });

  btnList.addEventListener('click', function () {
    if (currentView === 'list') return;
    currentView = 'list';
    cardView.style.display = 'none';
    listView.style.display = '';
    btnCard.classList.remove('active');
    btnList.classList.add('active');
    filterEntries(searchInput.value);
  });

  searchInput.addEventListener('input', function () {
    filterEntries(this.value);
  });

  function filterEntries(query) {
    var q = query.trim().toLowerCase();
    var container = currentView === 'card' ? cardView : listView;
    var entries = container.querySelectorAll('.rl-entry');
    var visible = 0;
    entries.forEach(function (el) {
      var text = el.getAttribute('data-search') || '';
      var match = q === '' || text.indexOf(q) !== -1;
      el.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    noResults.style.display = visible === 0 ? '' : 'none';
  }
})();
</script>
